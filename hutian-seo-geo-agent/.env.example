# ============================================================================
# 壶天 SEO/GEO Agent — 环境变量示例
# ============================================================================
# ⚠️ 当前阶段（v0.1/v0.2）代码不读取任何 LLM 配置。
#    前端走 mockStream，MCP 工具返回示意结构。
#
# 以下 LLM 配置为 **Phase3（v1.0）接 grok-build 时** 预留：
#    grok-build 运行时通过自己的模型路由读取这些值，本项目代码不直接调用。
#    届时把本文件复制为 .env 并填入真实 Key 即可。
# ============================================================================

# ---------- CodeBuddy / 腾讯云 TokenHub（OpenAI 兼容协议）----------
# Phase3 默认 LLM 来源。聚合多个模型，经统一端点调用。
# 端点：https://tokenhub.tencentmaas.com/v1（广州）
#       https://tokenhub-intl.tencentmaas.com/v1（新加坡）
CODEBUDDY_API_KEY=your-codebuddy-api-key-here
CODEBUDDY_API_BASE=https://tokenhub.tencentmaas.com/v1

# ---------- 可选：其他 OpenAI 兼容供应商（按需启用）----------
# Kimi Coding Plan（Moonshot）
# KIMI_API_KEY=your-kimi-api-key-here
# KIMI_API_BASE=https://api.kimi.com/coding/v1

# 商汤 SenseNova
# SENSENOVA_API_KEY=your-sensenova-api-key-here
# SENSENOVA_API_BASE=https://token.sensenova.cn/v1

# NVIDIA NIM
# NVIDIA_API_KEY=your-nvidia-api-key-here
# NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1

# Google AI Studio（Gemini）
# GOOGLE_API_KEY=your-google-api-key-here
# GOOGLE_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/

# ---------- 默认模型 ----------
# 工作台 TopBar 模型路由下拉的默认选项
# 可选：hy3-preview / deepseek-v4-flash / kimi-2.5
DEFAULT_MODEL=deepseek-v4-flash

# ---------- MCP 工具可选密钥（v0.2 起）----------
# 启用后 run_diagnosis 会返回真实 PageSpeed 性能分
PAGESPEED_API_KEY=

# 预留：未来接真实引用监测后端
HUTIAN_CITATION_API=

# ---------- Bridge 配置 ----------
BRIDGE_PORT=4317
# web 端 BFF 代理连接 bridge 的地址
BRIDGE_URL=http://localhost:4317
