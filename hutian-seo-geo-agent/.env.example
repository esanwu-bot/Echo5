# ============================================================================
# 壶天 SEO/GEO Agent — 环境变量示例
# ============================================================================
# v0.3 起，agent-bridge 自建 loop 经 CodeBuddyClient 调 LLM；前端 v0.2 走 mockStream。
# 把本文件复制为 .env 并填入真实 Key 即可启用真闭环。
# ----------------------------------------------------------------------------

# ---------- CodeBuddy / 腾讯云 TokenHub（OpenAI 兼容协议）----------
# v0.3 默认 LLM 来源。聚合多个模型，经统一端点调用。
# 端点：https://tokenhub.tencentmaas.com/v1（广州）
#       https://tokenhub-intl.tencentmaas.com/v1（新加坡）
CODEBUDDY_API_KEY=your-codebuddy-api-key-here
CODEBUDDY_API_BASE=https://tokenhub.tencentmaas.com/v1

# ---------- 可选：Grok（本地 CLIProxyAPI）----------
# 经本地 grok CLI / grok-build 暴露的 OpenAI 兼容端点接入。
# Grok 在此架构中只是 LLM 后端之一，不是 agent host。
# GROK_PROXY_BASE=http://localhost:52415/v1
# GROK_MODEL=grok-3-latest
# GROK_API_KEY=                    # CLIProxyAPI 多数不要求，可留空
# GROK_TIMEOUT_MS=30000
# GROK_RETRIES=1

# ---------- 可选：其他 OpenAI 兼容供应商（按需启用）----------
# Kimi Coding Plan（Moonshot）
# KIMI_API_KEY=your-kimi-api-key-here
# KIMI_API_BASE=https://api.kimi.com/coding/v1

# 商汤 SenseNova（OpenAI 兼容协议）
# 端点：https://token.sensenova.cn/v1
# 模型：sensenova-6.7-flash-lite
SENSENOVA_API_KEY=your-sensenova-api-key-here
SENSENOVA_API_BASE=https://token.sensenova.cn/v1
# SENSENOVA_MODEL=sensenova-6.7-flash-lite

# NVIDIA NIM
# NVIDIA_API_KEY=your-nvidia-api-key-here
# NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1

# Google AI Studio（Gemini）
# GOOGLE_API_KEY=your-google-api-key-here
# GOOGLE_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/

# ---------- LLM 供应商优先级 ----------
# "codebuddy" (默认) | "grok" | "sensenova" | "auto"
# - codebuddy: 只用 CodeBuddy，不探测 Grok
# - grok     : Grok 优先，CLIProxyAPI 未启动时降级到 CodeBuddy → Mock
# - sensenova: 商汤 SenseNova，OpenAI 兼容（需配 SENSENOVA_API_KEY）
# - auto     : Grok 活着就用，否则 CodeBuddy → Mock
# 注意：grok 默认优先级需在本地通过 probe:grok-derived + probe:grok-loop 探针验证后才启用。
LLM_PROVIDER=codebuddy

# ---------- 默认模型 ----------
# 工作台 TopBar 模型路由下拉的默认选项 / bridge CodeBuddyClient 默认模型
# 必须用 TokenHub 的"model 参数值"，见 https://cloud.tencent.com/document/product/1823/130079
# 可选：deepseek-v4-flash(默认) / kimi-k2.5 / hy3-preview / glm-5.2 / kimi-k2.7-code
DEFAULT_MODEL=deepseek-v4-flash
# CODEBUDDY_MODEL=deepseek-v4-flash  # 覆盖 CodeBuddyClient 默认模型

# ---------- MCP 工具可选密钥（v0.2 起）----------
# 启用后 run_diagnosis 会返回真实 PageSpeed 性能分
PAGESPEED_API_KEY=

# SERP 抓取（analyze_content_gap 工具依赖）
# 优先级：Serper.dev（自带高质量代理，MVP 最稳定）> OpenSERP（自托管免费）
# 两者均未配置时 analyze_content_gap 返回错误（fail-closed）。

# Serper.dev（Google SERP，优先使用）
SERPER_API_KEY=

# OpenSERP（开源/自托管，作为回退）
# 自托管：docker run -p 7000:7000 open-serp/open-serp
OPENSERP_BASE_URL=
# OPENSERP_API_KEY=your-openserp-cloud-api-key-here

# 预留：未来接真实引用监测后端
HUTIAN_CITATION_API=

# ---------- Bridge 配置 ----------
BRIDGE_PORT=4317
# web 端 BFF 代理连接 bridge 的地址
BRIDGE_URL=http://localhost:4317

# ---------- 多租户 tenant-api（M6）----------
# ⚠️ 双库物理隔离：hutian=壶天元数据，hutian_sitebase=独立站业务库，DSN 不可配混
#   - hutian         → tenant-api 管理（tenants/workspaces/seats/subscriptions/...）
#   - hutian_sitebase → siteBase 业务库，tenant-api 不动，靠每 workspace 一套实例隔离
#   - db.go 启动时强校验 DATABASE()="hutian"，连错库直接 fatal
TENANT_API_PORT=4318
TENANT_API_DEV=true
# hutian 元数据库 DSN（GORM 格式）— 库名必须是 hutian，不可写 hutian_sitebase
TENANT_META_DSN=root:root@tcp(localhost:3306)/hutian?charset=utf8mb4&parseTime=True&loc=Local
# 跨语言内部 token 密钥（HMAC-SHA256，Go 签发 → bridge/MCP 验签）
# 生产必须改为高熵随机串，不进仓库；dev 用此占位
TENANT_INTERNAL_TOKEN_KEY=dev-secret-key-change-in-prod
# 平台 admin super-admin token（长期 token，admin 后台用，与租户 HMAC token 物理隔离）
# admin 后台调 /admin/api/v1/* 必须带 X-Admin-Token: <此值>
# 生产必须改为高熵随机串；空则 admin 路由全 503（NFR-T01 红线：不得裸奔）
TENANT_ADMIN_TOKEN=dev-admin-token-change-in-prod
