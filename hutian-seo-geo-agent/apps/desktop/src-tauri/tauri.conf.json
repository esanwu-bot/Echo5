{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "壶天SEO-GEO Agent",
  "version": "0.1.0",
  "identifier": "com.hutian.seo-geo-agent",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "壶天 · SEO/GEO Agent",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "壶天 SEO/GEO Agent 桌面版",
    "longDescription": "壶天 AI SEO/GEO 智能优化工作台 —— 四步诊断、AI 引用追踪、结构化数据映射、站点地图提交、品牌实体更名。"
  }
}
